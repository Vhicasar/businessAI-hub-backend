# BusinessHub AI (product) — VPS deployment env. Fill EVERY value.
# openssl rand -base64 48  (JWT_SECRET)   ·   openssl rand -hex 32  (ENCRYPTION_KEY)

# GHCR owner (LOWERCASE) + image names (confirm on each repo's Packages page)
GHCR_OWNER=vhicasar
# AGENTV_BACKEND_IMAGE=ghcr.io/vhicasar/agentv-backend:latest
# AGENTV_WEB_IMAGE=ghcr.io/vhicasar/agentv-web:latest

# Product app domain (DNS A-record → VPS)
APP_DOMAIN=app.businesshub.vhicasar.com

# Database
DB_PASSWORD=replace-with-a-strong-db-password

# Auth
JWT_SECRET=replace-with-openssl-rand-base64-48
ENCRYPTION_KEY=replace-with-openssl-rand-hex-32

# Transactional email (required in production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=replace-with-smtp-password
MAIL_FROM=BusinessHub AI <no-reply@example.com>

# Shared with Vhicasar Admin's PRODUCT_SERVICE_KEY (minimum 24 characters).
# Generate once, then put the exact same value in both deployments.
SERVICE_API_KEY=replace-with-openssl-rand-base64-48

# AI (optional)
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Billing / Paystack (optional)
BILLING_CURRENCY=NGN
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CHARGE_CURRENCIES=NGN
BILLING_PROVIDER=paystack
ADMIN_PAYMENT_SYNC=true
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
BILLING_CALLBACK_URL=https://app.businesshub.vhicasar.com/billing

# Vhicasar Admin (pricing source of truth)
ADMIN_API_URL=https://admin.vhicasar.com
