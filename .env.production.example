# ── BusinessHub AI API — production ─────────────────────────────────────
# Copy to `.env` on the VPS (or provide via compose). Generate secrets with:
#   openssl rand -base64 48          # JWT_SECRET
#   openssl rand -hex 32             # ENCRYPTION_KEY (must be 64 hex chars)

NODE_ENV=production
PORT=4000

# Public URLs (product app domain). The web app proxies /api same-origin.
API_BASE_URL=https://app.businesshub.vhicasar.com
WEB_APP_URL=https://app.businesshub.vhicasar.com
CORS_ORIGINS=https://app.businesshub.vhicasar.com

# Database (its own DB — separate from the admin)
DATABASE_URL=postgresql://businesshub:REPLACE_DB_PASSWORD@agentv-postgres:5432/businesshub?schema=public

# Auth
JWT_ALG=HS256
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# AI (optional; 'none' disables AI features gracefully)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# Billing / Paystack (optional; blank secret = manual mode)
BILLING_CURRENCY=NGN
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# ── Vhicasar Admin — single source of truth for pricing ────────────────
# The backend syncs plan prices + quota limits from the admin's public API.
ADMIN_API_URL=https://admin.vhicasar.com
ADMIN_TENANT_SLUG=businesshub-ai
ADMIN_PLAN_SYNC=true
ADMIN_SYNC_INTERVAL_MIN=10

LOG_LEVEL=info
