# ── Vhicasar Hub AI API — production ────────────────────────────────────
# Copy to `.env` on the VPS (or provide via compose). Generate secrets with:
#   openssl rand -base64 48          # JWT_SECRET
#   openssl rand -hex 32             # ENCRYPTION_KEY (must be 64 hex chars)

NODE_ENV=production
PORT=4000

# Public URLs (product app domain). The web app proxies /api same-origin.
API_BASE_URL=https://app.businesshub.vhicasar.com
WEB_APP_URL=https://app.businesshub.vhicasar.com
CORS_ORIGINS=https://app.businesshub.vhicasar.com

# Database (its own DB — separate from the admin)
DATABASE_URL=postgresql://businesshub:REPLACE_DB_PASSWORD@agentv-postgres:5432/businesshub?schema=public

# Redis for BullMQ queues. Set this AND run the worker (`npm run worker`, or the
# agentv-worker compose service) to process workflow automations + campaign sends
# asynchronously. Leave unset to run them inline in the API process.
REDIS_URL=redis://agentv-redis:6379

# Auth
JWT_ALG=HS256
JWT_SECRET=REPLACE_WITH_openssl_rand_base64_48
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32

# Transactional email — required in production. Port 465 normally uses
# SMTP_SECURE=true; ports 587/2525 normally use false (STARTTLS).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@example.com
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=Vhicasar Hub AI <no-reply@example.com>

# Shared with the admin deployment's PRODUCT_SERVICE_KEY. The two values must
# be identical and at least 24 characters.
SERVICE_API_KEY=REPLACE_WITH_openssl_rand_base64_48

# AI (optional; 'none' disables AI features gracefully)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-5

# Billing / Paystack (optional; blank secret = manual mode)
BILLING_CURRENCY=NGN
PAYSTACK_CHARGE_CURRENCIES=NGN
FX_PROVIDER_URL=https://open.er-api.com/v6/latest
FX_CACHE_TTL_MIN=60
FX_MAX_STALE_HOURS=24
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
BILLING_PROVIDER=paystack
ADMIN_PAYMENT_SYNC=true
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
BILLING_CALLBACK_URL=https://app.businesshub.vhicasar.com/settings/billing

# ── Vhicasar Admin — single source of truth for pricing ────────────────
# The backend syncs plan prices + quota limits from the admin's public API.
ADMIN_API_URL=https://admin.vhicasar.com
ADMIN_TENANT_SLUG=businesshub-ai
ADMIN_PLAN_SYNC=true
ADMIN_SYNC_INTERVAL_MIN=10

LOG_LEVEL=info
