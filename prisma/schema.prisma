// ============================================================
// TENANCY & IDENTITY
// ============================================================

model Organization {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  businessType BusinessType @default(ECOMMERCE)
  status       OrgStatus    @default(TRIAL)
  logoFileId   String?
  website      String?
  email        String?
  phone        String?
  addressLine1 String?
  addressLine2 String?
  city         String?
  state        String?
  country      String?      @db.Char(2)
  postalCode   String?
  timezone     String       @default("UTC")
  /// Set from the owner's location at signup (see shared/currency.ts). This
  /// default only applies when that can't be determined — naira rather than
  /// USD, because the subscription plans are priced in NGN.
  currency     String       @default("NGN") @db.Char(3)
  locale       String       @default("en")
  settings     Json?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  branches        Branch[]
  departments     Department[]
  teams           Team[]
  memberships     Membership[]
  roles           Role[]
  invitations     Invitation[]
  subscriptions   Subscription[]
  apiKeys         ApiKey[]
  usageCounters   UsageCounter[]
  smsWallet       SmsWallet?
  addOnPurchases  AddOnPurchase[]
  customerLinks   CustomerLink[] // Vhicasar ID ↔ Customer associations
  wallets         Wallet[] // Vhicasar Pay merchant/fees wallets
  paymentSessions PaymentSession[]
  settlements     Settlement[]
  chargebacks     Chargeback[]
  PayoutAccount   PayoutAccount[]
  businessProfile BusinessProfile?
  businessQrs     BusinessQr[]

  settlementAccounts SettlementAccount[]
  settlementRules    SettlementRule[]

  @@index([status])
}

model Branch {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  code           String
  phone          String?
  email          String?
  addressLine1   String?
  city           String?
  state          String?
  country        String?   @db.Char(2)
  isHeadOffice   Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  departments  Department[]
  memberships  Membership[]
  warehouses   Warehouse[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Department {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  name           String
  code           String
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  teams        Team[]
  memberships  Membership[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([branchId])
}

model Team {
  id             String    @id @default(cuid())
  organizationId String
  departmentId   String?
  name           String
  description    String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])
  members      TeamMember[]

  @@index([organizationId])
}

model TeamMember {
  id       String   @id @default(cuid())
  teamId   String
  userId   String
  isLead   Boolean  @default(false)
  joinedAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([teamId, userId])
  @@index([userId])
}

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarFileId        String?
  status              UserStatus @default(ACTIVE)
  isSuperAdmin        Boolean    @default(false)
  emailVerifiedAt     DateTime?
  twoFactorEnabled    Boolean    @default(false)
  twoFactorSecretEnc  String?    @db.Text
  lastLoginAt         DateTime?
  failedLoginAttempts Int        @default(0)
  lockedUntil         DateTime?
  passwordChangedAt   DateTime?
  preferences         Json?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  memberships             Membership[]
  teamMemberships         TeamMember[]
  refreshTokens           RefreshToken[]
  securityTokens          SecurityToken[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  deviceTokens            DeviceToken[]

  @@index([status])
}

model Membership {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  roleId         String
  branchId       String?
  departmentId   String?
  jobTitle       String?
  isOwner        Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  department   Department?  @relation(fields: [departmentId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([roleId])
}

model Role {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  permissions  RolePermission[]
  memberships  Membership[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Permission {
  id          String  @id @default(cuid())
  key         String  @unique // e.g. "orders.create", "inbox.assign"
  module      String // e.g. "orders"
  description String?

  roles RolePermission[]

  @@index([module])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model RefreshToken {
  id             String    @id @default(cuid())
  userId         String
  tokenHash      String    @unique
  familyId       String // rotation family for reuse detection
  /// Business this session was last in. A rotation family is one device's
  /// session, so remembering it here is what lets a page reload — or reopening
  /// the app — land back in the business the user actually chose, rather than
  /// their oldest membership.
  organizationId String?
  userAgent      String?
  ipAddress      String?
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedBy     String?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([familyId])
}

model SecurityToken {
  id        String    @id @default(cuid())
  userId    String
  type      String // PASSWORD_RESET | EMAIL_VERIFY | TWO_FACTOR_BACKUP
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
}

/// Durable record of every transactional-email delivery attempt, so failures
/// are troubleshootable after the fact (the app logger is ephemeral) and a
/// background sweep can re-send verification emails that never got through.
/// One row per send() call, carrying the final outcome after the mailer's
/// internal retries.
model EmailDeliveryLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  /// EMAIL_VERIFY | PASSWORD_RESET | INVITATION | PASSWORD_CHANGED | NOTICE
  type           String
  recipient      String
  subject        String
  /// SENT | FAILED
  status         String
  attempts       Int      @default(1)
  provider       String? // SMTP host, or "dev-log" when no SMTP configured
  messageId      String?
  error          String?
  createdAt      DateTime @default(now())

  @@index([recipient, type, createdAt])
  @@index([userId, type, createdAt])
  @@index([status, type, createdAt])
}

model Invitation {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  invitedById    String
  /// Set when the invite was raised from an employee record; on acceptance the
  /// new user is linked back to it (Employee.userId), which is what makes the
  /// person assignable as an owner/approver.
  employeeId     String?
  tokenHash      String    @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id])

  @@unique([organizationId, email])
  @@index([employeeId])
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // FCM token
  platform  String // android | ios | web | windows | macos | linux
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id             String    @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String?
  displayName    String?
  email          String?
  phone          String?
  companyId      String?
  avatarFileId   String?
  dateOfBirth    DateTime?
  gender         String?
  language       String?
  timezone       String?
  aiSummary      String?   @db.Text
  aiSummaryAt    DateTime?
  lifetimeValue  Decimal   @default(0) @db.Decimal(14, 2)
  totalOrders    Int       @default(0)
  lastOrderAt    DateTime?
  lastContactAt  DateTime?
  marketingOptIn Boolean   @default(true)
  isBlocked      Boolean   @default(false)
  isProvisional  Boolean   @default(false) // anonymous web-chat identity; promoted when contact details are saved
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  company             Company?             @relation(fields: [companyId], references: [id])
  addresses           CustomerAddress[]
  identities          CustomerIdentity[]
  link                CustomerLink? // link to the global Vhicasar ID identity
  conversations       Conversation[]
  orders              Order[]
  carts               Cart[]
  invoices            Invoice[]
  payments            Payment[]
  tickets             Ticket[]
  leads               Lead[]
  deals               Deal[]
  loyaltyAccount      LoyaltyAccount?
  referralsGiven      Referral[]           @relation("Referrer")
  referralsReceived   Referral[]           @relation("Referred")
  ownedProperties     Property[]           @relation("PropertyOwner")
  leases              Lease[]              @relation("LeaseTenant")
  propertyBookings    PropertyBooking[]
  maintenanceRequests MaintenanceRequest[]
  quotations          Quotation[]
  contracts           Contract[]
  returnRequests      ReturnRequest[]

  @@unique([organizationId, email])
  @@unique([organizationId, phone])
  @@index([organizationId, createdAt])
  @@index([organizationId, isProvisional])
  @@index([companyId])
}

model CustomerAddress {
  id           String   @id @default(cuid())
  customerId   String
  label        String? // Home, Office…
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  country      String   @db.Char(2)
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer   @relation(fields: [customerId], references: [id])
  orders    Order[]    @relation("ShippingAddress")
  shipments Shipment[]

  @@index([customerId])
}

model CustomerIdentity {
  id               String      @id @default(cuid())
  organizationId   String
  customerId       String
  channelType      ChannelType
  externalId       String // WhatsApp phone, IG user id, Telegram chat id…
  displayName      String?
  profileUrl       String?
  channelAccountId String?
  isVerified       Boolean     @default(false)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  customer       Customer        @relation(fields: [customerId], references: [id])
  channelAccount ChannelAccount? @relation(fields: [channelAccountId], references: [id])

  @@unique([organizationId, channelType, externalId])
  @@index([customerId])
}

// ============================================================
// UNIFIED INBOX
// ============================================================

model ChannelAccount {
  id             String      @id @default(cuid())
  organizationId String
  channelType    ChannelType
  name           String // "Main WhatsApp", "Support Page"
  externalId     String // phone number id, page id, bot id…
  credentialsEnc String?     @db.Text // AES-256-GCM encrypted provider credentials
  webhookSecret  String?
  isActive       Boolean     @default(true)
  metadata       Json?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  conversations Conversation[]
  identities    CustomerIdentity[]

  @@unique([organizationId, channelType, externalId])
  @@index([organizationId])
}

model Conversation {
  id               String             @id @default(cuid())
  organizationId   String
  channelAccountId String
  customerId       String
  status           ConversationStatus @default(OPEN)
  subject          String?
  assignedToId     String? // Membership id
  assignedTeamId   String?
  lastMessageAt    DateTime?
  lastMessageText  String?            @db.Text
  unreadCount      Int                @default(0)
  isBotHandled     Boolean            @default(false)
  aiSentiment      String? // POSITIVE | NEUTRAL | NEGATIVE
  aiSummary        String?            @db.Text
  snoozedUntil     DateTime?
  closedAt         DateTime?
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  channelAccount ChannelAccount @relation(fields: [channelAccountId], references: [id])
  customer       Customer       @relation(fields: [customerId], references: [id])
  messages       Message[]
  calls          Call[]
  tickets        Ticket[]
  orders         Order[]

  @@index([organizationId, status, lastMessageAt])
  @@index([customerId])
  @@index([assignedToId])
  @@index([channelAccountId])
}

model Message {
  id                String             @id @default(cuid())
  organizationId    String
  conversationId    String
  direction         MessageDirection
  authorType        AuthorType
  authorUserId      String? // when agent
  contentType       MessageContentType @default(TEXT)
  body              String?            @db.Text
  status            MessageStatus      @default(QUEUED)
  providerMessageId String?
  replyToId         String?
  aiGenerated       Boolean            @default(false)
  aiIntent          String?
  aiSentiment       String?
  errorMessage      String?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime           @default(now())

  conversation Conversation        @relation(fields: [conversationId], references: [id])
  replyTo      Message?            @relation("MessageReply", fields: [replyToId], references: [id])
  replies      Message[]           @relation("MessageReply")
  attachments  MessageAttachment[]

  @@unique([conversationId, providerMessageId])
  @@index([organizationId, createdAt])
  @@index([conversationId, createdAt])
}

model MessageAttachment {
  id        String  @id @default(cuid())
  messageId String
  fileId    String
  caption   String?

  message Message @relation(fields: [messageId], references: [id])
  file    File    @relation(fields: [fileId], references: [id])

  @@index([messageId])
}

model Call {
  id              String        @id @default(cuid())
  organizationId  String
  conversationId  String?
  customerId      String?
  agentUserId     String?
  direction       CallDirection
  status          CallStatus
  isVideo         Boolean       @default(false)
  startedAt       DateTime?
  endedAt         DateTime?
  durationSeconds Int?
  recordingFileId String?
  transcription   String?       @db.Text
  aiSummary       String?       @db.Text
  createdAt       DateTime      @default(now())

  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([customerId])
}

model CannedResponse {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  shortcut       String // "/refund"
  body           String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, shortcut])
  @@index([organizationId])
}

// ============================================================
// CRM
// ============================================================

model Company {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  website        String?
  industry       String?
  size           String?
  email          String?
  phone          String?
  addressLine1   String?
  city           String?
  country        String?   @db.Char(2)
  customFields   Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  customers Customer[]
  deals     Deal[]
  leads     Lead[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Lead {
  id             String     @id @default(cuid())
  organizationId String
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  companyId      String?
  customerId     String? // set when converted/matched
  source         String? // WHATSAPP, WEBSITE, REFERRAL…
  status         LeadStatus @default(NEW)
  ownerId        String? // Membership id
  aiScore        Int? // 0-100
  aiScoreReason  String?    @db.Text
  estimatedValue Decimal?   @db.Decimal(14, 2)
  convertedAt    DateTime?
  customFields   Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  company  Company?  @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])
  deals    Deal[]

  @@index([organizationId, status])
  @@index([ownerId])
}

model Pipeline {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  isDefault      Boolean  @default(false)
  module         String   @default("SALES") // SALES | REAL_ESTATE | CUSTOM
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stages PipelineStage[]
  deals  Deal[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PipelineStage {
  id          String  @id @default(cuid())
  pipelineId  String
  name        String
  position    Int
  probability Int     @default(0) // 0-100
  isWonStage  Boolean @default(false)
  isLostStage Boolean @default(false)

  pipeline Pipeline @relation(fields: [pipelineId], references: [id])
  deals    Deal[]

  @@unique([pipelineId, position])
}

model Deal {
  id               String     @id @default(cuid())
  organizationId   String
  title            String
  pipelineId       String
  stageId          String
  customerId       String?
  companyId        String?
  leadId           String?
  ownerId          String? // Membership id
  status           DealStatus @default(OPEN)
  value            Decimal    @default(0) @db.Decimal(14, 2)
  currency         String     @default("USD") @db.Char(3)
  expectedCloseAt  DateTime?
  closedAt         DateTime?
  lostReason       String?
  aiWinProbability Int?
  customFields     Json?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  deletedAt        DateTime?

  pipeline   Pipeline      @relation(fields: [pipelineId], references: [id])
  stage      PipelineStage @relation(fields: [stageId], references: [id])
  customer   Customer?     @relation(fields: [customerId], references: [id])
  company    Company?      @relation(fields: [companyId], references: [id])
  lead       Lead?         @relation(fields: [leadId], references: [id])
  quotations Quotation[]
  contracts  Contract[]
  invoices   Invoice[]

  @@index([organizationId, status])
  @@index([pipelineId, stageId])
  @@index([ownerId])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  type           ActivityType
  entityType     EntityType
  entityId       String
  actorUserId    String?
  title          String
  body           String?      @db.Text
  metadata       Json?
  occurredAt     DateTime     @default(now())
  createdAt      DateTime     @default(now())

  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([actorUserId])
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  description    String?      @db.Text
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  assigneeId     String? // Membership id
  createdById    String?
  entityType     EntityType?
  entityId       String?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, status, dueAt])
  @@index([assigneeId])
  @@index([entityType, entityId])
}

model Meeting {
  id             String      @id @default(cuid())
  organizationId String
  title          String
  description    String?     @db.Text
  location       String?
  meetingUrl     String?
  startAt        DateTime
  endAt          DateTime
  organizerId    String? // Membership id (assigned staff/agent)
  entityType     EntityType?
  entityId       String?
  attendees      Json? // [{type: 'user'|'customer', id, name, email, response}]
  aiSummary      String?     @db.Text
  transcription  String?     @db.Text
  /// CONFIRMED | CANCELLED | COMPLETED — appointment lifecycle (#12).
  status         String      @default("CONFIRMED")
  /// Customer this appointment is for (booking flows); scalar, matches entityId style.
  customerId     String?
  /// Appointment type id from the org's appointment config.
  typeId         String?
  /// Where the booking came from: CHAT | MANUAL | WEB.
  source         String?
  /// Unguessable token for the public manage/cancel link in confirmations.
  bookingToken   String?     @unique
  /// Set once a reminder has been emailed, so the sweep never double-sends.
  reminderSentAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, startAt])
  @@index([entityType, entityId])
  @@index([customerId])
  @@index([status, startAt])
}

model Note {
  id             String     @id @default(cuid())
  organizationId String
  entityType     EntityType
  entityId       String
  authorUserId   String?
  body           String     @db.Text
  isPinned       Boolean    @default(false)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([organizationId, entityType, entityId])
}

model Tag {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  color          String? // hex
  createdAt      DateTime @default(now())

  assignments TagAssignment[]

  @@unique([organizationId, name])
}

model TagAssignment {
  id         String     @id @default(cuid())
  tagId      String
  entityType EntityType
  entityId   String
  createdAt  DateTime   @default(now())

  tag Tag @relation(fields: [tagId], references: [id])

  @@unique([tagId, entityType, entityId])
  @@index([entityType, entityId])
}

model Quotation {
  id             String          @id @default(cuid())
  organizationId String
  number         String
  customerId     String
  dealId         String?
  status         QuotationStatus @default(DRAFT)
  currency       String          @default("USD") @db.Char(3)
  subtotal       Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal         @default(0) @db.Decimal(14, 2)
  total          Decimal         @default(0) @db.Decimal(14, 2)
  validUntil     DateTime?
  notes          String?         @db.Text
  createdById    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  customer Customer        @relation(fields: [customerId], references: [id])
  deal     Deal?           @relation(fields: [dealId], references: [id])
  items    QuotationItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  variantId   String?
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  discount    Decimal @default(0) @db.Decimal(14, 2)
  total       Decimal @db.Decimal(14, 2)

  quotation Quotation       @relation(fields: [quotationId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([quotationId])
}

model Contract {
  id             String         @id @default(cuid())
  organizationId String
  number         String
  title          String
  customerId     String
  dealId         String?
  status         ContractStatus @default(DRAFT)
  value          Decimal?       @db.Decimal(14, 2)
  currency       String         @default("USD") @db.Char(3)
  startDate      DateTime?
  endDate        DateTime?
  signedAt       DateTime?
  documentFileId String?
  terms          String?        @db.Text
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  customer Customer @relation(fields: [customerId], references: [id])
  deal     Deal?    @relation(fields: [dealId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

// ============================================================
// CATALOG
// ============================================================

model ProductCategory {
  id             String    @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  description    String?   @db.Text
  imageFileId    String?
  position       Int       @default(0)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  parent   ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children ProductCategory[] @relation("CategoryTree")
  products Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
}

model Brand {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  slug           String
  logoFileId     String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  products Product[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Product {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  brandId        String?
  name           String
  slug           String
  description    String?       @db.Text
  status         ProductStatus @default(DRAFT)
  type           String        @default("PHYSICAL") // PHYSICAL | DIGITAL | SERVICE
  taxRate        Decimal       @default(0) @db.Decimal(5, 2)
  attributes     Json? // definition of variant option axes e.g. [{name:"Size",values:["S","M"]}]
  aiTags         Json? // AI-generated search/recommendation tags
  customFields   Json? // arbitrary extras, incl. externalId from an imported system
  isFeatured     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  brand       Brand?           @relation(fields: [brandId], references: [id])
  variants    ProductVariant[]
  images      ProductImage[]
  bundleItems BundleItem[]     @relation("BundleChild")
  bundles     ProductBundle[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@index([categoryId])
  @@index([brandId])
}

model ProductVariant {
  id             String    @id @default(cuid())
  organizationId String
  productId      String
  sku            String
  barcode        String?
  name           String? // "Red / XL"
  options        Json? // {Size:"XL", Color:"Red"}
  price          Decimal   @db.Decimal(14, 2)
  compareAtPrice Decimal?  @db.Decimal(14, 2)
  costPrice      Decimal?  @db.Decimal(14, 2)
  currency       String    @default("USD") @db.Char(3)
  weightGrams    Int?
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  imageFileId    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  product            Product             @relation(fields: [productId], references: [id])
  stockLevels        StockLevel[]
  stockMovements     StockMovement[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  transferItems      StockTransferItem[]
  priceListItems     PriceListItem[]
  quotationItems     QuotationItem[]
  bundleItems        BundleItem[]

  @@unique([organizationId, sku])
  @@index([productId])
  @@index([barcode])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  fileId    String
  altText   String?
  position  Int     @default(0)

  product Product @relation(fields: [productId], references: [id])
  file    File    @relation(fields: [fileId], references: [id])

  @@index([productId])
}

model PriceList {
  id             String   @id @default(cuid())
  organizationId String
  name           String // "Wholesale", "VIP"
  currency       String   @default("USD") @db.Char(3)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items PriceListItem[]

  @@unique([organizationId, name])
}

model PriceListItem {
  id          String  @id @default(cuid())
  priceListId String
  variantId   String
  price       Decimal @db.Decimal(14, 2)
  minQuantity Decimal @default(1) @db.Decimal(12, 3)

  priceList PriceList      @relation(fields: [priceListId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([priceListId, variantId, minQuantity])
}

model ProductBundle {
  id             String   @id @default(cuid())
  organizationId String
  productId      String // the bundle is itself a sellable product
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  product Product      @relation(fields: [productId], references: [id])
  items   BundleItem[]

  @@index([organizationId])
}

model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  variantId String?
  quantity  Decimal @default(1) @db.Decimal(12, 3)

  bundle  ProductBundle   @relation(fields: [bundleId], references: [id])
  product Product         @relation("BundleChild", fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([bundleId])
}

model Coupon {
  id                    String       @id @default(cuid())
  organizationId        String
  code                  String
  description           String?
  discountType          DiscountType
  discountValue         Decimal      @db.Decimal(14, 2)
  minOrderAmount        Decimal?     @db.Decimal(14, 2)
  maxDiscount           Decimal?     @db.Decimal(14, 2)
  usageLimit            Int?
  usageLimitPerCustomer Int?
  usedCount             Int          @default(0)
  startsAt              DateTime?
  expiresAt             DateTime?
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  redemptions CouponRedemption[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
}

model CouponRedemption {
  id         String   @id @default(cuid())
  couponId   String
  orderId    String
  customerId String?
  amount     Decimal  @db.Decimal(14, 2)
  createdAt  DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id])
  order  Order  @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([customerId])
}

model Promotion {
  id              String          @id @default(cuid())
  organizationId  String
  name            String
  description     String?         @db.Text
  discountType    DiscountType
  discountValue   Decimal         @db.Decimal(14, 2)
  status          PromotionStatus @default(SCHEDULED)
  appliesTo       Json? // {scope:'ALL'|'CATEGORIES'|'PRODUCTS', ids:[]}
  /// DISCOUNT | CASHBACK | BOGO | HAPPY_HOUR | FLASH_SALE | MEMBER | BIRTHDAY |
  /// SEASONAL | PRODUCT | SERVICE | BRANCH
  kind            String          @default("DISCOUNT")
  branchId        String?
  /// Spend ceiling for the campaign; null = unlimited.
  budget          Decimal?        @db.Decimal(14, 2)
  budgetSpent     Decimal         @default(0) @db.Decimal(14, 2)
  /// {segmentIds:[], tiers:[], tags:[], newCustomersOnly:bool}
  audience        Json?
  minSpend        Decimal?        @db.Decimal(14, 2)
  /// Total redemptions allowed across all customers.
  maxRedemptions  Int?
  /// Redemptions allowed per customer.
  maxPerCustomer  Int             @default(1)
  redemptionCount Int             @default(0)
  /// Happy-hour / flash windows: {days:[1..7], from:"17:00", to:"19:00"}
  schedule        Json?
  /// When to push-notify subscribers.
  notifyAt        DateTime?
  notifiedAt      DateTime?
  imageUrl        String?
  terms           String?         @db.Text
  startsAt        DateTime
  endsAt          DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  redemptions PromotionRedemption[]

  @@index([organizationId, status])
  @@index([organizationId, startsAt, endsAt])
}

// ============================================================
// INVENTORY
// ============================================================

model Warehouse {
  id             String    @id @default(cuid())
  organizationId String
  branchId       String?
  /// Membership id of the staff member responsible for this warehouse.
  managerId      String?
  name           String
  code           String
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?   @db.Char(2)
  phone          String?
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  branch         Branch?         @relation(fields: [branchId], references: [id])
  stockLevels    StockLevel[]
  movements      StockMovement[]
  transfersFrom  StockTransfer[] @relation("TransferFrom")
  transfersTo    StockTransfer[] @relation("TransferTo")
  purchaseOrders PurchaseOrder[]
  orders         Order[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model StockLevel {
  id             String   @id @default(cuid())
  organizationId String
  warehouseId    String
  variantId      String
  quantity       Decimal  @default(0) @db.Decimal(12, 3)
  reserved       Decimal  @default(0) @db.Decimal(12, 3)
  reorderPoint   Decimal? @db.Decimal(12, 3)
  reorderQty     Decimal? @db.Decimal(12, 3)
  binLocation    String?
  updatedAt      DateTime @updatedAt

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([warehouseId, variantId])
  @@index([organizationId])
  @@index([variantId])
}

model StockMovement {
  id             String            @id @default(cuid())
  organizationId String
  warehouseId    String
  variantId      String
  type           StockMovementType
  quantity       Decimal           @db.Decimal(12, 3) // signed
  referenceType  String? // ORDER | PURCHASE_ORDER | TRANSFER | ADJUSTMENT | RETURN
  referenceId    String?
  reason         String?
  actorUserId    String?
  createdAt      DateTime          @default(now())

  warehouse Warehouse      @relation(fields: [warehouseId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([organizationId, createdAt])
  @@index([warehouseId, variantId])
  @@index([referenceType, referenceId])
}

model StockTransfer {
  id              String         @id @default(cuid())
  organizationId  String
  number          String
  fromWarehouseId String
  toWarehouseId   String
  status          TransferStatus @default(DRAFT)
  notes           String?        @db.Text
  createdById     String?
  shippedAt       DateTime?
  receivedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id])
  items         StockTransferItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model StockTransferItem {
  id          String   @id @default(cuid())
  transferId  String
  variantId   String
  quantity    Decimal  @db.Decimal(12, 3)
  receivedQty Decimal? @db.Decimal(12, 3)

  transfer StockTransfer  @relation(fields: [transferId], references: [id])
  variant  ProductVariant @relation(fields: [variantId], references: [id])

  @@index([transferId])
}

model Supplier {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  email          String?
  phone          String?
  addressLine1   String?
  city           String?
  country        String?   @db.Char(2)
  paymentTerms   String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  purchaseOrders PurchaseOrder[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model PurchaseOrder {
  id             String              @id @default(cuid())
  organizationId String
  number         String
  supplierId     String
  warehouseId    String
  status         PurchaseOrderStatus @default(DRAFT)
  currency       String              @default("USD") @db.Char(3)
  subtotal       Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal             @default(0) @db.Decimal(14, 2)
  total          Decimal             @default(0) @db.Decimal(14, 2)
  expectedAt     DateTime?
  orderedAt      DateTime?
  receivedAt     DateTime?
  notes          String?             @db.Text
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  variantId       String
  quantity        Decimal @db.Decimal(12, 3)
  receivedQty     Decimal @default(0) @db.Decimal(12, 3)
  unitCost        Decimal @db.Decimal(14, 2)
  taxRate         Decimal @default(0) @db.Decimal(5, 2)
  total           Decimal @db.Decimal(14, 2)

  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  variant       ProductVariant @relation(fields: [variantId], references: [id])

  @@index([purchaseOrderId])
}

// ============================================================
// ORDERS & FULFILLMENT
// ============================================================

model Cart {
  id             String      @id @default(cuid())
  organizationId String
  customerId     String?
  sessionId      String? // anonymous web/chat sessions
  source         OrderSource @default(WEB)
  status         CartStatus  @default(ACTIVE)
  currency       String      @default("USD") @db.Char(3)
  couponCode     String?
  expiresAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer Customer?  @relation(fields: [customerId], references: [id])
  items    CartItem[]

  @@index([organizationId, status])
  @@index([customerId])
  @@index([sessionId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  variantId String
  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(14, 2)

  cart    Cart           @relation(fields: [cartId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
}

model Order {
  id                String        @id @default(cuid())
  organizationId    String
  number            String
  customerId        String
  status            OrderStatus   @default(PENDING)
  source            OrderSource   @default(MANUAL)
  conversationId    String? // social-commerce origin
  warehouseId       String?
  shippingAddressId String?
  currency          String        @default("USD") @db.Char(3)
  subtotal          Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal          Decimal       @default(0) @db.Decimal(14, 2)
  shippingTotal     Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(14, 2)
  total             Decimal       @default(0) @db.Decimal(14, 2)
  paymentStatus     PaymentStatus @default(PENDING)
  couponCode        String?
  notes             String?       @db.Text
  placedById        String? // agent Membership id when created on behalf
  aiCreated         Boolean       @default(false)
  cancelledAt       DateTime?
  cancelReason      String?
  deliveredAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer          Customer             @relation(fields: [customerId], references: [id])
  conversation      Conversation?        @relation(fields: [conversationId], references: [id])
  warehouse         Warehouse?           @relation(fields: [warehouseId], references: [id])
  shippingAddress   CustomerAddress?     @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  items             OrderItem[]
  shipments         Shipment[]
  invoices          Invoice[]
  payments          Payment[]
  returnRequests    ReturnRequest[]
  couponRedemptions CouponRedemption[]
  statusHistory     OrderStatusHistory[]

  @@unique([organizationId, number])
  @@index([organizationId, status, createdAt])
  @@index([customerId])
  @@index([conversationId])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String
  name         String // snapshot
  sku          String // snapshot
  quantity     Decimal @db.Decimal(12, 3)
  unitPrice    Decimal @db.Decimal(14, 2)
  taxRate      Decimal @default(0) @db.Decimal(5, 2)
  discount     Decimal @default(0) @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)
  fulfilledQty Decimal @default(0) @db.Decimal(12, 3)
  returnedQty  Decimal @default(0) @db.Decimal(12, 3)

  order       Order          @relation(fields: [orderId], references: [id])
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([variantId])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  note        String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, createdAt])
}

model Shipment {
  id                String         @id @default(cuid())
  organizationId    String
  orderId           String
  number            String
  status            ShipmentStatus @default(PENDING)
  carrier           String?
  trackingNumber    String?
  trackingUrl       String?
  shippingAddressId String?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  order           Order            @relation(fields: [orderId], references: [id])
  shippingAddress CustomerAddress? @relation(fields: [shippingAddressId], references: [id])

  @@unique([organizationId, number])
  @@index([orderId])
  @@index([trackingNumber])
}

model ReturnRequest {
  id             String       @id @default(cuid())
  organizationId String
  number         String
  orderId        String
  customerId     String
  status         ReturnStatus @default(REQUESTED)
  reason         String?      @db.Text
  resolutionNote String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order    Order        @relation(fields: [orderId], references: [id])
  customer Customer     @relation(fields: [customerId], references: [id])
  items    ReturnItem[]
  refunds  Refund[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([orderId])
}

model ReturnItem {
  id          String  @id @default(cuid())
  returnId    String
  orderItemId String
  quantity    Decimal @db.Decimal(12, 3)
  condition   String? // NEW | OPENED | DAMAGED
  restock     Boolean @default(false)

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@index([returnId])
}

model Refund {
  id             String       @id @default(cuid())
  organizationId String
  paymentId      String
  returnId       String?
  amount         Decimal      @db.Decimal(14, 2)
  status         RefundStatus @default(PENDING)
  reason         String?
  providerRef    String?
  processedAt    DateTime?
  createdAt      DateTime     @default(now())

  payment       Payment        @relation(fields: [paymentId], references: [id])
  returnRequest ReturnRequest? @relation(fields: [returnId], references: [id])

  @@index([organizationId])
  @@index([paymentId])
}

// ============================================================
// INVOICING & PAYMENTS
// ============================================================

model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  number         String
  customerId     String
  orderId        String?
  dealId         String? // CRM deal this invoice was generated from
  leaseId        String? // real-estate rent invoices
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("USD") @db.Char(3)
  subtotal       Decimal       @default(0) @db.Decimal(14, 2)
  taxTotal       Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(14, 2)
  total          Decimal       @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(14, 2)
  issuedAt       DateTime?
  dueAt          DateTime?
  paidAt         DateTime?
  pdfFileId      String?
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  customer Customer      @relation(fields: [customerId], references: [id])
  order    Order?        @relation(fields: [orderId], references: [id])
  deal     Deal?         @relation(fields: [dealId], references: [id])
  lease    Lease?        @relation(fields: [leaseId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueAt])
  @@index([customerId])
  @@index([dealId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitPrice   Decimal @db.Decimal(14, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)
  total       Decimal @db.Decimal(14, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model Payment {
  id             String            @id @default(cuid())
  organizationId String
  customerId     String?
  orderId        String?
  invoiceId      String?
  method         PaymentMethodType
  status         PaymentStatus     @default(PENDING)
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @default("USD") @db.Char(3)
  provider       String? // adapter key: e.g. "stripe", "paystack", "manual"
  providerRef    String? // gateway transaction id
  idempotencyKey String?           @unique
  receivedById   String? // Membership id (cash/POS)
  paidAt         DateTime?
  failureReason  String?
  metadata       Json?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  customer    Customer?    @relation(fields: [customerId], references: [id])
  order       Order?       @relation(fields: [orderId], references: [id])
  invoice     Invoice?     @relation(fields: [invoiceId], references: [id])
  refunds     Refund[]
  chargebacks Chargeback[]

  @@index([organizationId, status, createdAt])
  @@index([customerId])
  @@index([orderId])
  @@index([providerRef])
}

enum PaymentLinkStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  EXPIRED
  CANCELLED
}

enum PaymentLinkResource {
  ORDER
  INVOICE
  PROPERTY_PURCHASE
  PROPERTY_RESERVATION
  BOOKING
  QUOTATION
  SUBSCRIPTION
  DEPOSIT
  POS
  MEMBERSHIP
  RENT
  SERVICE
  CUSTOM
}

/// A shareable, secure link to collect payment for any payable resource.
/// Scalar resourceId (no FK) keeps it universal across orders, invoices,
/// property sales/reservations, bookings, quotations, deposits and custom
/// charges. The public token drives the /pay/<token> page.
model PaymentLink {
  id             String              @id @default(cuid())
  organizationId String
  resourceType   PaymentLinkResource
  resourceId     String?
  customerId     String?
  token          String              @unique
  amount         Decimal             @db.Decimal(14, 2)
  amountPaid     Decimal             @default(0) @db.Decimal(14, 2)
  currency       String              @default("USD") @db.Char(3)
  description    String?
  status         PaymentLinkStatus   @default(PENDING)
  allowPartial   Boolean             @default(false)
  expiresAt      DateTime?
  provider       String? // gateway used for the latest attempt
  providerRef    String? // latest gateway reference
  createdById    String? // Membership id
  metadata       Json?
  paidAt         DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([customerId])
  @@index([resourceType, resourceId])
}

// ============================================================
// MARKETING
// ============================================================

model Segment {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  description    String?
  definition     Json // rule tree e.g. {all:[{field:'lifetimeValue',op:'gte',value:100}]}
  isDynamic      Boolean   @default(true)
  memberCount    Int       @default(0)
  computedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  campaigns Campaign[]

  @@unique([organizationId, name])
}

model Campaign {
  id             String         @id @default(cuid())
  organizationId String
  name           String
  type           CampaignType
  status         CampaignStatus @default(DRAFT)
  segmentId      String?
  subject        String?
  content        Json // template body, media, buttons
  scheduledAt    DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  stats          Json? // {sent, delivered, opened, clicked, bounced}
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  segment    Segment?            @relation(fields: [segmentId], references: [id])
  recipients CampaignRecipient[]

  @@index([organizationId, status])
}

model CampaignRecipient {
  id         String          @id @default(cuid())
  campaignId String
  customerId String
  status     RecipientStatus @default(PENDING)
  sentAt     DateTime?
  openedAt   DateTime?
  clickedAt  DateTime?
  error      String?

  campaign Campaign @relation(fields: [campaignId], references: [id])

  @@unique([campaignId, customerId])
  @@index([customerId])
}

model AutomationWorkflow {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  status         AutomationStatus @default(DRAFT)
  trigger        Json // {event:'order.delivered', conditions:[...]}
  steps          Json // ordered actions: wait, send, tag, assign, webhook…
  runCount       Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model LoyaltyProgram {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  name            String
  pointsPerAmount Decimal  @default(1) @db.Decimal(10, 4) // points per 1 currency unit
  redeemRate      Decimal  @default(0.01) @db.Decimal(10, 4) // currency per point
  expiryMonths    Int?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts    LoyaltyAccount[]
  LoyaltyRule LoyaltyRule[]
}

model LoyaltyAccount {
  id         String   @id @default(cuid())
  programId  String
  customerId String   @unique
  balance    Int      @default(0)
  tier       String?
  updatedAt  DateTime @updatedAt

  program      LoyaltyProgram       @relation(fields: [programId], references: [id])
  customer     Customer             @relation(fields: [customerId], references: [id])
  transactions LoyaltyTransaction[]

  @@index([programId])
}

model LoyaltyTransaction {
  id            String                 @id @default(cuid())
  accountId     String
  type          LoyaltyTransactionType
  points        Int // signed
  referenceType String?
  referenceId   String?
  note          String?
  createdAt     DateTime               @default(now())

  account LoyaltyAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, createdAt])
}

model Referral {
  id             String    @id @default(cuid())
  organizationId String
  referrerId     String
  referredId     String
  code           String
  rewardPoints   Int?
  rewardedAt     DateTime?
  createdAt      DateTime  @default(now())

  referrer Customer @relation("Referrer", fields: [referrerId], references: [id])
  referred Customer @relation("Referred", fields: [referredId], references: [id])

  @@unique([organizationId, referredId])
  @@index([referrerId])
}

// ============================================================
// SUPPORT
// ============================================================

model SlaPolicy {
  id                   String         @id @default(cuid())
  organizationId       String
  name                 String
  priority             TicketPriority
  firstResponseMinutes Int
  resolutionMinutes    Int
  businessHoursOnly    Boolean        @default(true)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tickets Ticket[]

  @@unique([organizationId, name])
}

model Ticket {
  id                 String         @id @default(cuid())
  organizationId     String
  number             String
  subject            String
  description        String?        @db.Text
  status             TicketStatus   @default(OPEN)
  priority           TicketPriority @default(MEDIUM)
  customerId         String
  conversationId     String?
  assigneeId         String? // Membership id
  departmentId       String?
  slaPolicyId        String?
  firstResponseDueAt DateTime?
  resolutionDueAt    DateTime?
  firstRespondedAt   DateTime?
  resolvedAt         DateTime?
  closedAt           DateTime?
  escalatedAt        DateTime?
  satisfactionScore  Int? // 1-5 CSAT
  npsScore           Int? // 0-10 "would you recommend"
  cesScore           Int? // 1-7 customer effort score
  aiSentiment        String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  customer     Customer      @relation(fields: [customerId], references: [id])
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  slaPolicy    SlaPolicy?    @relation(fields: [slaPolicyId], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status, priority])
  @@index([customerId])
  @@index([assigneeId])
}

model TicketComment {
  id             String   @id @default(cuid())
  organizationId String
  ticketId       String
  authorType     String   @default("AGENT") // AGENT | CUSTOMER | SYSTEM | AI
  authorUserId   String?
  body           String   @db.Text
  isInternal     Boolean  @default(false) // internal note vs. customer-visible reply
  createdAt      DateTime @default(now())

  @@index([organizationId, ticketId, createdAt])
}

model KbCategory {
  id             String   @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  slug           String
  position       Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  parent   KbCategory?  @relation("KbTree", fields: [parentId], references: [id])
  children KbCategory[] @relation("KbTree")
  articles KbArticle[]

  @@unique([organizationId, slug])
}

model KbArticle {
  id             String        @id @default(cuid())
  organizationId String
  categoryId     String?
  title          String
  slug           String
  body           String        @db.Text
  status         ArticleStatus @default(DRAFT)
  isPublic       Boolean       @default(true)
  viewCount      Int           @default(0)
  helpfulCount   Int           @default(0)
  authorUserId   String?
  publishedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  category KbCategory? @relation(fields: [categoryId], references: [id])

  // Full-text search: Postgres GIN tsvector index added via raw SQL migration
  // (Prisma @@fulltext is not supported on PostgreSQL).
  @@unique([organizationId, slug])
  @@index([organizationId, status])
}

model Faq {
  id             String   @id @default(cuid())
  organizationId String
  question       String
  answer         String   @db.Text
  position       Int      @default(0)
  isPublic       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ============================================================
// REAL ESTATE
// ============================================================

model Property {
  id             String          @id @default(cuid())
  organizationId String
  reference      String
  title          String
  description    String?         @db.Text
  type           PropertyType
  purpose        PropertyPurpose
  status         PropertyStatus  @default(AVAILABLE)
  ownerId        String? // Customer acting as property owner
  agentId        String? // Membership id
  price          Decimal?        @db.Decimal(14, 2)
  rentAmount     Decimal?        @db.Decimal(14, 2)
  rentPeriod     String? // MONTHLY | QUARTERLY | YEARLY
  currency       String          @default("USD") @db.Char(3)
  bedrooms       Int?
  bathrooms      Int?
  areaSqm        Decimal?        @db.Decimal(12, 2)
  yearBuilt      Int?
  addressLine1   String?
  city           String?
  state          String?
  country        String?         @db.Char(2)
  latitude       Decimal?        @db.Decimal(10, 7)
  longitude      Decimal?        @db.Decimal(10, 7)
  amenities      Json? // ["Pool","Parking"]
  videoTourUrl   String?
  customFields   Json?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  owner       Customer?            @relation("PropertyOwner", fields: [ownerId], references: [id])
  media       PropertyMedia[]
  leases      Lease[]
  bookings    PropertyBooking[]
  maintenance MaintenanceRequest[]
  commissions Commission[]

  @@unique([organizationId, reference])
  @@index([organizationId, status, type])
  @@index([ownerId])
  @@index([agentId])
}

model PropertyMedia {
  id         String  @id @default(cuid())
  propertyId String
  fileId     String
  kind       String  @default("IMAGE") // IMAGE | VIDEO | DOCUMENT | FLOOR_PLAN
  caption    String?
  position   Int     @default(0)

  property Property @relation(fields: [propertyId], references: [id])
  file     File     @relation(fields: [fileId], references: [id])

  @@index([propertyId])
}

model Lease {
  id             String      @id @default(cuid())
  organizationId String
  number         String
  propertyId     String
  tenantId       String // Customer
  status         LeaseStatus @default(DRAFT)
  rentAmount     Decimal     @db.Decimal(14, 2)
  currency       String      @default("USD") @db.Char(3)
  billingPeriod  String      @default("MONTHLY")
  depositAmount  Decimal?    @db.Decimal(14, 2)
  startDate      DateTime
  endDate        DateTime
  terminatedAt   DateTime?
  contractFileId String?
  notes          String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  property Property  @relation(fields: [propertyId], references: [id])
  tenant   Customer  @relation("LeaseTenant", fields: [tenantId], references: [id])
  invoices Invoice[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([propertyId])
  @@index([tenantId])
}

model PropertyBooking {
  id             String        @id @default(cuid())
  organizationId String
  propertyId     String
  customerId     String
  agentId        String? // Membership id
  kind           String        @default("VIEWING") // VIEWING | INSPECTION
  status         BookingStatus @default(REQUESTED)
  scheduledAt    DateTime
  durationMin    Int           @default(30)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  property Property @relation(fields: [propertyId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([organizationId, scheduledAt])
  @@index([propertyId])
  @@index([agentId])
}

model MaintenanceRequest {
  id             String              @id @default(cuid())
  organizationId String
  number         String
  propertyId     String
  requestedById  String // Customer (tenant/owner)
  status         MaintenanceStatus   @default(OPEN)
  priority       MaintenancePriority @default(MEDIUM)
  title          String
  description    String?             @db.Text
  assignedToId   String? // Membership id
  cost           Decimal?            @db.Decimal(14, 2)
  scheduledAt    DateTime?
  completedAt    DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  property    Property @relation(fields: [propertyId], references: [id])
  requestedBy Customer @relation(fields: [requestedById], references: [id])

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([propertyId])
}

model Commission {
  id             String           @id @default(cuid())
  organizationId String
  propertyId     String?
  agentId        String // Membership id
  dealType       String // SALE | RENT
  baseAmount     Decimal          @db.Decimal(14, 2)
  rate           Decimal          @db.Decimal(5, 2) // percent
  amount         Decimal          @db.Decimal(14, 2)
  currency       String           @default("USD") @db.Char(3)
  status         CommissionStatus @default(PENDING)
  approvedById   String?
  paidAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  property Property? @relation(fields: [propertyId], references: [id])

  @@index([organizationId, status])
  @@index([agentId])
}

// ============================================================
// HR
// ============================================================

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  userId         String?        @unique // optional platform login
  employeeNumber String
  firstName      String
  lastName       String
  email          String?
  phone          String?
  jobTitle       String?
  branchId       String?
  departmentId   String?
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ACTIVE)
  hiredAt        DateTime?
  terminatedAt   DateTime?
  salary         Decimal?       @db.Decimal(14, 2)
  currency       String         @default("USD") @db.Char(3)
  customFields   Json?
  avatarFileId   String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  shiftAssignments ShiftAssignment[]
  attendance       AttendanceRecord[]
  payComponents    EmployeePayComponent[]
  payslips         Payslip[]
  assetAssignments AssetAssignment[]
  expenseClaims    ExpenseClaim[]
  reviews          PerformanceReview[]
  goals            Goal[]
  feedback         Feedback[]
  enrollments      Enrollment[]
  invitations      Invitation[]

  @@unique([organizationId, employeeNumber])
  @@index([organizationId, status])
}

enum CycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum ReviewStatus {
  PENDING
  SUBMITTED
  ACKNOWLEDGED
}

enum GoalType {
  KPI
  OKR
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  ACHIEVED
  MISSED
}

enum FeedbackType {
  PRAISE
  CONSTRUCTIVE
  GENERAL
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model PerformanceCycle {
  id             String      @id @default(cuid())
  organizationId String
  name           String
  periodStart    DateTime    @db.Date
  periodEnd      DateTime    @db.Date
  status         CycleStatus @default(DRAFT)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  reviews PerformanceReview[]
  goals   Goal[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model PerformanceReview {
  id             String       @id @default(cuid())
  organizationId String
  cycleId        String
  employeeId     String
  reviewerId     String? // Membership id
  status         ReviewStatus @default(PENDING)
  overallRating  Int? // 1-5
  strengths      String?      @db.Text
  improvements   String?      @db.Text
  comments       String?      @db.Text
  submittedAt    DateTime?
  acknowledgedAt DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  cycle    PerformanceCycle @relation(fields: [cycleId], references: [id])
  employee Employee         @relation(fields: [employeeId], references: [id])

  @@unique([cycleId, employeeId])
  @@index([organizationId, status])
}

model Goal {
  id             String     @id @default(cuid())
  organizationId String
  employeeId     String
  cycleId        String?
  title          String
  description    String?    @db.Text
  type           GoalType   @default(KPI)
  targetValue    Float?
  currentValue   Float?     @default(0)
  unit           String?
  weight         Int        @default(1)
  progress       Int        @default(0) // 0-100
  status         GoalStatus @default(NOT_STARTED)
  dueAt          DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  employee Employee          @relation(fields: [employeeId], references: [id])
  cycle    PerformanceCycle? @relation(fields: [cycleId], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

model Feedback {
  id             String       @id @default(cuid())
  organizationId String
  employeeId     String
  authorUserId   String?
  type           FeedbackType @default(GENERAL)
  body           String       @db.Text
  isPrivate      Boolean      @default(false) // manager-only
  createdAt      DateTime     @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([organizationId, employeeId, createdAt])
}

model Course {
  id             String   @id @default(cuid())
  organizationId String
  title          String
  description    String?  @db.Text
  category       String   @default("GENERAL") // ONBOARDING | COMPLIANCE | SKILLS…
  durationMins   Int      @default(0)
  contentUrl     String?
  isMandatory    Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  enrollments Enrollment[]

  @@unique([organizationId, title])
  @@index([organizationId, isActive])
}

model Enrollment {
  id             String           @id @default(cuid())
  organizationId String
  courseId       String
  employeeId     String
  status         EnrollmentStatus @default(ENROLLED)
  progress       Int              @default(0) // 0-100
  score          Int? // assessment result
  certificateUrl String?
  enrolledAt     DateTime         @default(now())
  completedAt    DateTime?
  expiresAt      DateTime? // recertification due
  updatedAt      DateTime         @updatedAt

  course   Course   @relation(fields: [courseId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([courseId, employeeId])
  @@index([organizationId, status])
  @@index([employeeId])
}

enum JobStatus {
  DRAFT
  OPEN
  CLOSED
  FILLED
}

enum ApplicantStage {
  APPLIED
  SCREENING
  INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model JobPosting {
  id             String         @id @default(cuid())
  organizationId String
  reference      String
  title          String
  departmentId   String?
  description    String?        @db.Text
  employmentType EmploymentType @default(FULL_TIME)
  location       String?
  status         JobStatus      @default(DRAFT)
  openings       Int            @default(1)
  salaryMin      Decimal?       @db.Decimal(14, 2)
  salaryMax      Decimal?       @db.Decimal(14, 2)
  currency       String         @default("USD") @db.Char(3)
  publishedAt    DateTime?
  closedAt       DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  applicants Applicant[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
}

model Applicant {
  id              String         @id @default(cuid())
  organizationId  String
  jobPostingId    String
  firstName       String
  lastName        String
  email           String?
  phone           String?
  resumeUrl       String?
  resumeText      String?        @db.Text // pasted/parsed CV — feeds AI scoring
  source          String? // CAREER_PORTAL | REFERRAL | LINKEDIN | AGENCY…
  stage           ApplicantStage @default(APPLIED)
  aiScore         Int? // 0-100 fit
  aiScoreReason   String?        @db.Text
  notes           String?        @db.Text
  hiredEmployeeId String? // set when converted to an Employee
  appliedAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  jobPosting JobPosting  @relation(fields: [jobPostingId], references: [id])
  interviews Interview[]

  @@index([organizationId, stage])
  @@index([jobPostingId])
}

model Interview {
  id             String          @id @default(cuid())
  organizationId String
  applicantId    String
  scheduledAt    DateTime
  durationMin    Int             @default(45)
  interviewerId  String? // Membership id
  mode           String          @default("VIDEO") // VIDEO | PHONE | ONSITE
  meetingUrl     String?
  status         InterviewStatus @default(SCHEDULED)
  feedback       String?         @db.Text
  rating         Int? // 1-5
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  applicant Applicant @relation(fields: [applicantId], references: [id])

  @@index([organizationId, scheduledAt])
  @@index([applicantId])
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
  LOST
}

enum ExpenseStatus {
  SUBMITTED
  APPROVED
  REJECTED
  REIMBURSED
}

model Asset {
  id             String      @id @default(cuid())
  organizationId String
  assetTag       String
  name           String
  category       String      @default("OTHER") // LAPTOP | PHONE | VEHICLE | LICENSE | ACCESS_CARD…
  serialNumber   String?
  status         AssetStatus @default(AVAILABLE)
  purchaseDate   DateTime?
  purchaseCost   Decimal?    @db.Decimal(14, 2)
  currency       String      @default("USD") @db.Char(3)
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  assignments AssetAssignment[]

  @@unique([organizationId, assetTag])
  @@index([organizationId, status])
}

model AssetAssignment {
  id             String    @id @default(cuid())
  organizationId String
  assetId        String
  employeeId     String
  assignedAt     DateTime  @default(now())
  returnedAt     DateTime?
  notes          String?

  asset    Asset    @relation(fields: [assetId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([organizationId, assetId])
  @@index([employeeId])
}

model ExpenseClaim {
  id             String        @id @default(cuid())
  organizationId String
  reference      String
  employeeId     String
  title          String
  category       String        @default("OTHER") // TRAVEL | MEALS | ACCOMMODATION | SUPPLIES…
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD") @db.Char(3)
  incurredAt     DateTime      @db.Date
  description    String?       @db.Text
  receiptFileId  String?
  status         ExpenseStatus @default(SUBMITTED)
  approverId     String? // Membership id
  decidedAt      DateTime?
  decisionNote   String?
  reimbursedAt   DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId, status])
  @@index([employeeId])
}

enum PayComponentType {
  EARNING
  DEDUCTION
}

enum PayCalcMethod {
  FIXED
  PERCENT_OF_BASIC
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}

/// An earning or deduction line definition (allowance, pension, tax…).
/// Jurisdiction-specific tax rules are intentionally NOT modelled — configure
/// them as PERCENT_OF_BASIC / FIXED components to suit local regulation.
model PayComponent {
  id             String           @id @default(cuid())
  organizationId String
  name           String
  code           String
  type           PayComponentType
  calc           PayCalcMethod    @default(FIXED)
  amount         Float            @default(0) // fixed amount, or percent when PERCENT_OF_BASIC
  appliesToAll   Boolean          @default(false)
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignments EmployeePayComponent[]

  @@unique([organizationId, code])
}

model EmployeePayComponent {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  componentId    String
  amountOverride Float?
  createdAt      DateTime @default(now())

  employee  Employee     @relation(fields: [employeeId], references: [id])
  component PayComponent @relation(fields: [componentId], references: [id])

  @@unique([employeeId, componentId])
  @@index([organizationId])
}

model PayrollRun {
  id              String           @id @default(cuid())
  organizationId  String
  reference       String
  periodStart     DateTime         @db.Date
  periodEnd       DateTime         @db.Date
  status          PayrollRunStatus @default(DRAFT)
  currency        String           @default("USD") @db.Char(3)
  totalGross      Decimal          @default(0) @db.Decimal(14, 2)
  totalDeductions Decimal          @default(0) @db.Decimal(14, 2)
  totalNet        Decimal          @default(0) @db.Decimal(14, 2)
  employeeCount   Int              @default(0)
  notes           String?
  approvedById    String? // Membership id
  approvedAt      DateTime?
  paidAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  payslips Payslip[]

  @@unique([organizationId, reference])
  @@index([organizationId, status])
}

model Payslip {
  id              String   @id @default(cuid())
  organizationId  String
  payrollRunId    String
  employeeId      String
  basicSalary     Decimal  @db.Decimal(14, 2)
  overtimePay     Decimal  @default(0) @db.Decimal(14, 2)
  grossPay        Decimal  @db.Decimal(14, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(14, 2)
  netPay          Decimal  @db.Decimal(14, 2)
  currency        String   @default("USD") @db.Char(3)
  overtimeMinutes Int      @default(0)
  lines           Json // [{ name, code, type, amount }]
  createdAt       DateTime @default(now())

  payrollRun PayrollRun @relation(fields: [payrollRunId], references: [id])
  employee   Employee   @relation(fields: [employeeId], references: [id])

  @@unique([payrollRunId, employeeId])
  @@index([organizationId])
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HALF_DAY
}

model Shift {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  startTime      String // "09:00" local
  endTime        String // "17:00" local (may wrap past midnight)
  breakMinutes   Int      @default(0)
  daysOfWeek     Int[] // 0=Sun … 6=Sat
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments ShiftAssignment[]
  attendance  AttendanceRecord[]

  @@unique([organizationId, name])
}

model ShiftAssignment {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  shiftId        String
  date           DateTime @db.Date
  createdAt      DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift    @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  organizationId  String
  employeeId      String
  shiftId         String?
  date            DateTime         @db.Date
  clockInAt       DateTime?
  clockOutAt      DateTime?
  breakMinutes    Int              @default(0)
  workedMinutes   Int              @default(0)
  overtimeMinutes Int              @default(0)
  lateMinutes     Int              @default(0)
  status          AttendanceStatus @default(PRESENT)
  source          String           @default("WEB") // WEB | GPS | QR | BIOMETRIC
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
  shift    Shift?   @relation(fields: [shiftId], references: [id])

  @@unique([employeeId, date])
  @@index([organizationId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveType {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  code             String
  daysPerYear      Float    @default(0) // default annual entitlement
  isPaid           Boolean  @default(true)
  requiresApproval Boolean  @default(true)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([organizationId, code])
}

model LeaveBalance {
  id              String   @id @default(cuid())
  organizationId  String
  employeeId      String
  leaveTypeId     String
  year            Int
  entitledDays    Float    @default(0)
  usedDays        Float    @default(0)
  carriedOverDays Float    @default(0)
  updatedAt       DateTime @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@unique([employeeId, leaveTypeId, year])
  @@index([organizationId])
}

model LeaveRequest {
  id             String      @id @default(cuid())
  organizationId String
  employeeId     String
  leaveTypeId    String
  startDate      DateTime
  endDate        DateTime
  days           Float // working days requested
  reason         String?     @db.Text
  status         LeaveStatus @default(PENDING)
  approverId     String? // Membership id
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  employee  Employee  @relation(fields: [employeeId], references: [id])
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])

  @@index([organizationId, status])
  @@index([employeeId])
}

// ============================================================
// SAAS BILLING & PLATFORM ADMIN
// ============================================================

model Plan {
  id                String   @id @default(cuid())
  name              String   @unique
  slug              String   @unique
  description       String?
  /// The plan's base price, in `currency`. Used when `prices` has nothing for
  /// the customer's currency — i.e. today's behaviour, unchanged.
  priceMonthly      Decimal  @db.Decimal(14, 2)
  priceYearly       Decimal  @db.Decimal(14, 2)
  currency          String   @default("USD") @db.Char(3)
  /// Per-currency price book, synced from the admin:
  /// { "NGN": { "monthly": 8500, "yearly": 81600 }, "USD": { ... } }
  /// A currency absent here is never charged — we don't convert (see
  /// shared/billing-currency.ts).
  prices            Json?
  maxUsers          Int?
  maxBranches       Int?
  maxProducts       Int?
  maxChannels       Int?
  maxContacts       Int?
  /// Maximum opted-in recipients a single marketing campaign may target.
  maxMarketingReach Int?
  aiCreditsMonthly  Int?
  features          Json // feature keys enabled on this plan
  isPublic          Boolean  @default(true) // shown on pricing UI (false = custom/contact-sales)
  isActive          Boolean  @default(true)
  position          Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  subscriptions Subscription[]
}

/// Maps a local plan (× interval × currency) to the recurring plan created in a
/// payment gateway (Paystack Plan code / Flutterwave Payment Plan id), so a
/// subscription checkout charges through a real gateway plan and shows up as a
/// Subscription in the provider dashboard. Reused across checkouts; recreated
/// when the plan's price changes (see billing.service.ensureProviderPlan).
model ProviderPlan {
  id               String       @id @default(cuid())
  provider         String // "paystack" | "flutterwave"
  planId           String
  interval         PlanInterval
  currency         String       @db.Char(3)
  /// Recurring amount in the smallest currency unit the plan was created with;
  /// a change means the price moved and a new gateway plan is needed.
  amountMinor      Int
  providerPlanCode String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([provider, planId, interval, currency])
  @@index([provider, providerPlanCode])
}

model Subscription {
  id                       String             @id @default(cuid())
  organizationId           String
  planId                   String
  status                   SubscriptionStatus @default(TRIALING)
  interval                 PlanInterval       @default(MONTHLY)
  trialEndsAt              DateTime?
  currentPeriodStart       DateTime
  currentPeriodEnd         DateTime
  cancelAtPeriodEnd        Boolean            @default(false)
  cancelledAt              DateTime?
  // Payment-provider linkage (e.g. Paystack customer / subscription codes).
  provider                 String?
  providerCustomerCode     String?
  providerSubscriptionCode String?
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id])
  plan           Plan            @relation(fields: [planId], references: [id])
  billingRecords BillingRecord[]

  @@index([organizationId, status])
  @@index([planId])
}

/// Per-organization, per-period usage meter (e.g. AI responses consumed this
/// billing period). Reset implicitly by a new periodStart; enforced against
/// the org's current plan limits.
model UsageCounter {
  id             String   @id @default(cuid())
  organizationId String
  metric         String // "ai_response", ...
  periodStart    DateTime
  periodEnd      DateTime
  value          Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, metric, periodStart])
  @@index([organizationId, metric])
}

/// Purchased entitlement extensions sourced from the admin-managed add-on
/// catalog. The entitlement snapshot keeps an existing purchase stable even
/// if the catalog is edited later.
model AddOnPurchase {
  id             String    @id @default(cuid())
  organizationId String
  addOnId        String
  title          String
  billingType    String
  amount         Decimal   @db.Decimal(14, 2)
  currency       String    @db.Char(3)
  entitlements   Json
  provider       String?
  providerRef    String?   @unique
  purchasedAt    DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, expiresAt])
  @@index([organizationId, addOnId])
}

/// Prepaid SMS balance. Amounts are monetary and always use `currency`.
model SmsWallet {
  id                  String    @id @default(cuid())
  organizationId      String    @unique
  balance             Decimal   @default(0) @db.Decimal(14, 4)
  currency            String    @default("NGN") @db.Char(3)
  lowBalanceThreshold Decimal   @default(500) @db.Decimal(14, 4)
  lastLowBalanceAt    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id])
  transactions SmsWalletTransaction[]
}

model SmsWalletTransaction {
  id             String                   @id @default(cuid())
  organizationId String
  walletId       String
  type           SmsWalletTransactionType
  channelType    ChannelType              @default(SMS)
  amount         Decimal                  @db.Decimal(14, 4)
  balanceAfter   Decimal                  @db.Decimal(14, 4)
  currency       String                   @db.Char(3)
  description    String
  reference      String?
  campaignId     String?
  customerId     String?
  metadata       Json?
  createdAt      DateTime                 @default(now())

  wallet SmsWallet @relation(fields: [walletId], references: [id])

  @@unique([organizationId, reference])
  @@index([organizationId, createdAt])
  @@index([walletId])
  @@index([organizationId, channelType, createdAt])
}

model BillingRecord {
  id                     String        @id @default(cuid())
  subscriptionId         String
  amount                 Decimal       @db.Decimal(14, 2)
  currency               String        @default("USD") @db.Char(3)
  sourceAmount           Decimal?      @db.Decimal(14, 2)
  sourceCurrency         String?       @db.Char(3)
  exchangeRate           Decimal?      @db.Decimal(24, 12)
  exchangeRateSnapshotId String?
  status                 PaymentStatus @default(PENDING)
  periodStart            DateTime
  periodEnd              DateTime
  provider               String?
  providerRef            String?
  paidAt                 DateTime?
  invoicePdfFileId       String?
  createdAt              DateTime      @default(now())

  subscription         Subscription          @relation(fields: [subscriptionId], references: [id])
  exchangeRateSnapshot ExchangeRateSnapshot? @relation(fields: [exchangeRateSnapshotId], references: [id])

  @@index([subscriptionId])
}

/// Immutable provider observations used to reproduce converted display and
/// charged amounts. Rates express one unit of `baseCurrency` in `quoteCurrency`.
model ExchangeRateSnapshot {
  id                String    @id @default(cuid())
  baseCurrency      String    @db.Char(3)
  quoteCurrency     String    @db.Char(3)
  rate              Decimal   @db.Decimal(24, 12)
  provider          String
  providerUpdatedAt DateTime?
  fetchedAt         DateTime  @default(now())
  expiresAt         DateTime
  createdAt         DateTime  @default(now())

  billingRecords BillingRecord[]

  @@index([baseCurrency, quoteCurrency, fetchedAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  keyHash        String    @unique
  prefix         String // visible identifier e.g. "bh_live_a1b2"
  scopes         Json // permission keys
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?
  isEnabled   Boolean  @default(false) // global default
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  overrides FeatureFlagOverride[]
}

model FeatureFlagOverride {
  id             String  @id @default(cuid())
  flagId         String
  organizationId String
  isEnabled      Boolean

  flag FeatureFlag @relation(fields: [flagId], references: [id])

  @@unique([flagId, organizationId])
}

model WebhookEndpoint {
  id             String    @id @default(cuid())
  organizationId String
  url            String
  secret         String
  events         Json // ["order.created","message.received"]
  isActive       Boolean   @default(true)
  lastSuccessAt  DateTime?
  lastFailureAt  DateTime?
  failureCount   Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

model IntegrationCredential {
  id             String   @id @default(cuid())
  organizationId String
  provider       String // "stripe" | "twilio" | "google_maps" | custom adapter keys
  credentialsEnc String   @db.Text
  isActive       Boolean  @default(true)
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, provider])
}

// ============================================================
// PLATFORM SERVICES
