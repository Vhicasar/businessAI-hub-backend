// BusinessHub AI — Prisma Schema (PostgreSQL)
// Multi-tenant: every tenant-scoped model carries organizationId.
// Compound uniques always include organizationId.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; "debian-openssl-3.0.x" for the production Docker
  // image (node:22-bookworm-slim). Avoids Prisma's Alpine/OpenSSL engine issues.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

