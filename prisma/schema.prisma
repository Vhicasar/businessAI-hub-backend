model File {
  id             String        @id @default(cuid())
  organizationId String? // null for platform-level files
  driver         StorageDriver @default(LOCAL)
  key            String        @unique // storage path/object key
  fileName       String
  mimeType       String
  sizeBytes      Int
  checksum       String?
  uploadedById   String?
  entityType     EntityType?
  entityId       String?
  isPublic       Boolean       @default(false)
  createdAt      DateTime      @default(now())
  deletedAt      DateTime?

  messageAttachments MessageAttachment[]
  productImages      ProductImage[]
  propertyMedia      PropertyMedia[]

  @@index([organizationId])
  @@index([entityType, entityId])
}

model Notification {
  id             String    @id @default(cuid())
  organizationId String?
  userId         String
  type           String // event key e.g. "inbox.assigned"
  title          String
  body           String?   @db.Text
  data           Json? // deep-link payload
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id      String              @id @default(cuid())
  userId  String
  type    String // event key or "*"
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, type, channel])
