model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorUserId    String?
  actorType      String   @default("USER") // USER | SYSTEM | API_KEY | AI
  action         String // "order.update", "auth.login"…
  entityType     String?
  entityId       String?
  before         Json?
  after          Json?
  ipAddress      String?
  userAgent      String?
