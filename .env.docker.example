# Copy to deploy/backend.env and fill in real values.
# DATABASE_URL and PORT are injected by docker-compose — do not set them here.

NODE_ENV=production

# Public URLs (behind your domain/reverse proxy)
API_BASE_URL=https://app.example.com
WEB_APP_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com

# --- Auth (generate fresh values!) ---
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ALG=HS256
JWT_SECRET=REPLACE_ME_48_BYTES
# Production recommendation: RS256 (see docs/DEPLOYMENT.md)
# JWT_ALG=RS256
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt.key
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt.key.pub
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=REPLACE_ME_64_HEX

# --- Mail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="BusinessHub AI <no-reply@example.com>"

# --- Storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# --- AI (optional) ---
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# --- Billing / Paystack (optional; blank secret = manual mode, free plans only) ---
BILLING_CURRENCY=NGN
PAYSTACK_CHARGE_CURRENCIES=NGN
FX_PROVIDER_URL=https://open.er-api.com/v6/latest
FX_CACHE_TTL_MIN=60
FX_MAX_STALE_HOURS=24
PAYSTACK_SECRET_KEY=sk_test_4b735e51c309caa860f45b3da370e71b31f5f20c
PAYSTACK_PUBLIC_KEY=pk_test_bf80501307b65babdbfd94e3a1ba8f6bea6eb851

LOG_LEVEL=info
